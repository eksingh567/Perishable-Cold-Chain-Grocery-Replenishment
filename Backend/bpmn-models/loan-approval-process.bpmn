<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  id="Definitions_LoanApproval" 
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" 
                  exporterVersion="5.20.0">
  <bpmn:process id="Process_LoanApproval" name="End-to-End Loan Approval Automation" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanSubmitted" name="Loan Application Submitted">
      <bpmn:outgoing>Flow_ToValidateApplicant</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ValidateApplicant" name="Validate Applicant Information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-applicant-info" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidateApplicant</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayValidation</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ValidApplicant" name="Applicant Valid?">
      <bpmn:incoming>Flow_ToGatewayValidation</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CreditAssessment" name="Credit Assessment REST Connector">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="creditResponse" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;POST&quot;" target="method" />
          <zeebe:input source="=&quot;http://localhost:8081/api/credit/assess&quot;" target="url" />
          <zeebe:input source="={ &quot;applicantId&quot;: applicantId, &quot;requestedAmount&quot;: requestedAmount, &quot;monthlyIncome&quot;: monthlyIncome }" target="body" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:output source="=creditResponse.body.creditRiskScore" target="creditRiskScore" />
          <zeebe:output source="=creditResponse.body.riskCategory" target="riskCategory" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidationPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDMN</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_EvaluateDecision" name="Evaluate Loan Rules (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_LoanEligibility" resultVariable="approvalResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDMN</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayDecision</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_DecisionOutcome" name="Decision Result" default="Flow_ToManualReview">
      <bpmn:incoming>Flow_ToGatewayDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToManualReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task configured as native Camunda Form / Tasklist user task -->
    <bpmn:userTask id="Task_ManualReview" name="Manual Loan Review (Tasklist)">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ManualLoanReview" />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_FromManualReview</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ManualReviewOutcome" name="Manual Decision?">
      <bpmn:incoming>Flow_FromManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Joining Gateway for Approvals -->
    <bpmn:exclusiveGateway id="Gateway_JoinApproved">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_ManualApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovedEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Joining Gateway for Rejections -->
    <bpmn:exclusiveGateway id="Gateway_JoinRejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_ValidationFailed</bpmn:incoming>
      <bpmn:incoming>Flow_ManualRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejectedEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Approved" name="Loan Approved">
      <bpmn:incoming>Flow_ToApprovedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Loan Rejected">
      <bpmn:incoming>Flow_ToRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToValidateApplicant" sourceRef="StartEvent_LoanSubmitted" targetRef="Task_ValidateApplicant" />
    <bpmn:sequenceFlow id="Flow_ToGatewayValidation" sourceRef="Task_ValidateApplicant" targetRef="Gateway_ValidApplicant" />
    <bpmn:sequenceFlow id="Flow_ValidationPassed" name="Valid" sourceRef="Gateway_ValidApplicant" targetRef="Task_CreditAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isValidApplicant = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ValidationFailed" name="Invalid Details" sourceRef="Gateway_ValidApplicant" targetRef="Gateway_JoinRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isValidApplicant = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToDMN" sourceRef="Task_CreditAssessment" targetRef="Task_EvaluateDecision" />
    <bpmn:sequenceFlow id="Flow_ToGatewayDecision" sourceRef="Task_EvaluateDecision" targetRef="Gateway_DecisionOutcome" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_DecisionOutcome" targetRef="Gateway_JoinApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalResult = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_DecisionOutcome" targetRef="Gateway_JoinRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalResult = "Rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToManualReview" name="Manual Review" sourceRef="Gateway_DecisionOutcome" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_FromManualReview" sourceRef="Task_ManualReview" targetRef="Gateway_ManualReviewOutcome" />
    <bpmn:sequenceFlow id="Flow_ManualApproved" name="Officer Approved" sourceRef="Gateway_ManualReviewOutcome" targetRef="Gateway_JoinApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=manualReviewDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManualRejected" name="Officer Rejected" sourceRef="Gateway_ManualReviewOutcome" targetRef="Gateway_JoinRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=manualReviewDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToApprovedEnd" sourceRef="Gateway_JoinApproved" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_ToRejectedEnd" sourceRef="Gateway_JoinRejected" targetRef="EndEvent_Rejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LoanApproval">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_LoanSubmitted">
        <dc:Bounds x="162" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="139" y="225" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Validate_di" bpmnElement="Task_ValidateApplicant">
        <dc:Bounds x="260" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidApplicant_di" bpmnElement="Gateway_ValidApplicant" isMarkerVisible="true">
        <dc:Bounds x="445" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="145" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Credit_di" bpmnElement="Task_CreditAssessment">
        <dc:Bounds x="560" y="160" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_DMN_di" bpmnElement="Task_EvaluateDecision">
        <dc:Bounds x="750" y="160" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_DecisionOutcome" isMarkerVisible="true">
        <dc:Bounds x="945" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="931" y="151" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ManualReview_di" bpmnElement="Task_ManualReview">
        <dc:Bounds x="1050" y="160" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManualOutcome_di" bpmnElement="Gateway_ManualReviewOutcome" isMarkerVisible="true">
        <dc:Bounds x="1235" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1217" y="151" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinApproved_di" bpmnElement="Gateway_JoinApproved" isMarkerVisible="true">
        <dc:Bounds x="1345" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinRejected_di" bpmnElement="Gateway_JoinRejected" isMarkerVisible="true">
        <dc:Bounds x="1345" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1452" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1433" y="125" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1452" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1434" y="345" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToValidateApplicant_di" bpmnElement="Flow_ToValidateApplicant">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGatewayValidation_di" bpmnElement="Flow_ToGatewayValidation">
        <di:waypoint x="380" y="200" />
        <di:waypoint x="445" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ValidationPassed_di" bpmnElement="Flow_ValidationPassed">
        <di:waypoint x="495" y="200" />
        <di:waypoint x="560" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="515" y="182" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ValidationFailed_di" bpmnElement="Flow_ValidationFailed">
        <di:waypoint x="470" y="225" />
        <di:waypoint x="470" y="320" />
        <di:waypoint x="1345" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="293" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDMN_di" bpmnElement="Flow_ToDMN">
        <di:waypoint x="690" y="200" />
        <di:waypoint x="750" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGatewayDecision_di" bpmnElement="Flow_ToGatewayDecision">
        <di:waypoint x="880" y="200" />
        <di:waypoint x="945" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="970" y="175" />
        <di:waypoint x="970" y="100" />
        <di:waypoint x="1345" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="986" y="103" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="970" y="225" />
        <di:waypoint x="970" y="320" />
        <di:waypoint x="1345" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="987" y="303" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToManualReview_di" bpmnElement="Flow_ToManualReview">
        <di:waypoint x="995" y="200" />
        <di:waypoint x="1050" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="990" y="182" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromManualReview_di" bpmnElement="Flow_FromManualReview">
        <di:waypoint x="1180" y="200" />
        <di:waypoint x="1235" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManualApproved_di" bpmnElement="Flow_ManualApproved">
        <di:waypoint x="1260" y="175" />
        <di:waypoint x="1260" y="100" />
        <di:waypoint x="1345" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1268" y="103" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManualRejected_di" bpmnElement="Flow_ManualRejected">
        <di:waypoint x="1260" y="225" />
        <di:waypoint x="1260" y="320" />
        <di:waypoint x="1345" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1268" y="303" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToApprovedEnd_di" bpmnElement="Flow_ToApprovedEnd">
        <di:waypoint x="1395" y="100" />
        <di:waypoint x="1452" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRejectedEnd_di" bpmnElement="Flow_ToRejectedEnd">
        <di:waypoint x="1395" y="320" />
        <di:waypoint x="1452" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
